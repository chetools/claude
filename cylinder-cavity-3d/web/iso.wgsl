var<private> EA: array<u32, 12> = array<u32, 12>(0u, 1u, 2u, 3u, 4u, 5u, 6u, 7u, 0u, 1u, 2u, 3u);
var<private> EB: array<u32, 12> = array<u32, 12>(1u, 2u, 3u, 0u, 5u, 6u, 7u, 4u, 4u, 5u, 6u, 7u);
var<private> CO: array<vec3<i32>, 8> = array<vec3<i32>, 8>(
  vec3<i32>(0, 0, 0), vec3<i32>(1, 0, 0), vec3<i32>(1, 1, 0), vec3<i32>(0, 1, 0),
  vec3<i32>(0, 0, 1), vec3<i32>(1, 0, 1), vec3<i32>(1, 1, 1), vec3<i32>(0, 1, 1));

fn fa(i: i32, j: i32, k: i32) -> f32 { return FA[u32((k * I.n + j) * I.n + i)]; }
fn fb(i: i32, j: i32, k: i32) -> f32 { return FB[u32((k * I.n + j) * I.n + i)]; }
fn wrapk(k: i32) -> i32 {
  if (I.periodic != 0u) { return (k + I.nz) % I.nz; }
  return clamp(k, 0, I.nz - 1);
}
fn grad(i: i32, j: i32, k: i32) -> vec3<f32> {
  let n = I.n;
  let gx = fa(min(i + 1, n - 1), j, k) - fa(max(i - 1, 0), j, k);
  let gy = fa(i, min(j + 1, n - 1), k) - fa(i, max(j - 1, 0), k);
  let gz = fa(i, j, wrapk(k + 1)) - fa(i, j, wrapk(k - 1));
  return vec3<f32>(gx, gy, gz);
}

@compute @workgroup_size(64)
fn cs_mc(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) li: u32) {
  let idx = i32((wid.y * 65535u + wid.x) * 64u + li);
  let nc = I.n - 1;
  var nzc = I.nz - 1;
  if (I.periodic != 0u) { nzc = I.nz + 1; }
  if (nc < 1 || nzc < 1) { return; }
  if (idx >= nc * nc * nzc) { return; }
  let ci = idx % nc; let cj = (idx / nc) % nc; let kc = idx / (nc * nc);
  var k0 = kc; var k1 = kc + 1; var zb = (f32(kc) + 0.5) * I.h;
  if (I.periodic != 0u && kc >= I.nz - 1) {
    k0 = I.nz - 1; k1 = 0;
    zb = select((f32(I.nz) - 0.5) * I.h, -0.5 * I.h, kc == I.nz);
  }
  let iso = select(I.iso, I.frac * RA[1], I.use_frac != 0u);
  var val: array<f32, 8>;
  var cube = 0u;
  for (var c = 0u; c < 8u; c++) {
    let o = CO[c];
    let k = select(k0, k1, o.z == 1);
    val[c] = fa(ci + o.x, cj + o.y, k);
    if (val[c] < iso) { cube |= 1u << c; }
  }
  if (cube == 0u || cube == 255u) { return; }
  // count triangles
  var nt = 0u;
  for (var m = 0u; m < 15u; m += 3u) {
    let t = cube * 16u + m;
    if (((TRI[t >> 3u] >> ((t & 7u) * 4u)) & 15u) == 15u) { break; }
    nt++;
  }
  let base = atomicAdd(&CNT[0], nt);
  if (base + nt > I.max_tris) { return; }
  for (var q = 0u; q < nt; q++) {
    for (var v = 0u; v < 3u; v++) {
      let t = cube * 16u + q * 3u + v;
      let e = (TRI[t >> 3u] >> ((t & 7u) * 4u)) & 15u;
      let a = EA[e]; let b = EB[e];
      let oa = CO[a]; let ob = CO[b];
      let va = val[a]; let vb = val[b];
      let den = vb - va;
      let s = select(0.5, clamp((iso - va) / den, 0.0, 1.0), abs(den) > 1.0e-30);
      let ka = select(k0, k1, oa.z == 1); let kb = select(k0, k1, ob.z == 1);
      let pa = vec3<f32>((f32(ci + oa.x) + 0.5) * I.h, (f32(cj + oa.y) + 0.5) * I.h, zb + f32(oa.z) * I.h);
      let pb = vec3<f32>((f32(ci + ob.x) + 0.5) * I.h, (f32(cj + ob.y) + 0.5) * I.h, zb + f32(ob.z) * I.h);
      var o: Vert;
      o.pos = mix(pa, pb, s);
      o.pos.z = clamp(o.pos.z, 0.0, I.Lz);
      let ga = grad(ci + oa.x, cj + oa.y, ka); let gb = grad(ci + ob.x, cj + ob.y, kb);
      let g = mix(ga, gb, s);
      o.nrm = g / max(length(g), 1.0e-30);
      o.cval = 0.0;
      if (I.has_c != 0u) { o.cval = mix(fb(ci + oa.x, cj + oa.y, ka), fb(ci + ob.x, cj + ob.y, kb), s); }
      o.pad = 0.0;
      VW[(base + q) * 3u + v] = o;
    }
  }
}

@compute @workgroup_size(1)
fn cs_args() {
  let t = min(atomicLoad(&CNT[0]), I.max_tris);
  ARGS[0] = t * 3u; ARGS[1] = 1u; ARGS[2] = 0u; ARGS[3] = 0u;
}

// ---------------------------------------------------------------- mesh drawing
struct MOut {
  @builtin(position) pos: vec4<f32>,
  @location(0) wp: vec3<f32>, @location(1) nrm: vec3<f32>, @location(2) cval: f32,
};
@vertex
fn vs_mesh(@builtin(vertex_index) vi: u32) -> MOut {
  let v = VR[vi];
  var o: MOut;
  o.pos = I.vp * vec4<f32>(v.pos, 1.0);
  o.wp = v.pos; o.nrm = v.nrm; o.cval = v.cval;
  return o;
}
fn diverging(t: f32) -> vec3<f32> {
  let lo = vec3<f32>(0.23, 0.30, 0.75); let mid = vec3<f32>(0.97, 0.97, 0.97); let hi = vec3<f32>(0.71, 0.016, 0.15);
  if (t < 0.0) { return mix(mid, lo, -t); }
  return mix(mid, hi, t);
}
fn sequential(t: f32) -> vec3<f32> {
  var c = array<vec3<f32>, 5>(vec3<f32>(0.267, 0.005, 0.329), vec3<f32>(0.230, 0.322, 0.546),
    vec3<f32>(0.128, 0.567, 0.551), vec3<f32>(0.369, 0.789, 0.383), vec3<f32>(0.993, 0.906, 0.144));
  let s = clamp(t, 0.0, 1.0) * 4.0;
  let k = min(i32(floor(s)), 3);
  return mix(c[k], c[k + 1], s - f32(k));
}
@fragment
fn fs_mesh(i: MOut) -> @location(0) vec4<f32> {
  var n = normalize(i.nrm);
  let v = normalize(I.eye.xyz - i.wp);
  if (dot(n, v) < 0.0) { n = -n; }
  var base = vec3<f32>(0.93, 0.55, 0.20);
  if (I.has_c != 0u) {
    var lo = I.clo; var hi = I.chi;
    if (I.c_auto != 0u) { lo = RB[0]; hi = RB[1]; }
    if (I.c_signed != 0u) { base = diverging(clamp(i.cval / max(max(abs(lo), abs(hi)), 1.0e-30), -1.0, 1.0)); }
    else { base = sequential((i.cval - lo) / max(hi - lo, 1.0e-30)); }
  }
  let key = normalize(vec3<f32>(0.4, -0.5, 0.8));
  let lit = 0.25 + 0.5 * dot(n, v) + 0.3 * max(dot(n, key), 0.0);
  return vec4<f32>(base * min(lit, 1.2), 1.0);
}
