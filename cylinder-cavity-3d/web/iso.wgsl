// iso.wgsl: marching cubes (classic 256-case table, Lorensen & Cline; corner/edge numbering of P. Bourke)
// in a compute shader, plus the mesh vertex/fragment shaders.
// Nodes are the cell centres.  Cell (i,j,kc) spans nodes i..i+1, j..j+1 and two z-nodes.  Periodic z adds
// two copies of the wrap cell (nodes nz-1 and 0), placed above z=Lz-h/2 and below z=h/2 and clamped to
// the box, so the surface fills the whole box; walls: only the nz-1 interior cells.
struct IP {
  n: i32, nz: i32, periodic: u32, max_tris: u32,
  h: f32, Lz: f32, iso: f32, frac: f32,
  use_frac: u32, has_c: u32, c_signed: u32, c_auto: u32,
  clo: f32, chi: f32, p0: f32, p1: f32,
  eye: vec4<f32>,
  vp: mat4x4<f32>,
};
struct Vert { pos: vec3<f32>, cval: f32, nrm: vec3<f32>, pad: f32 };

@group(0) @binding(0) var<uniform> I: IP;
@group(0) @binding(1) var<storage, read> FA: array<f32>;
@group(0) @binding(2) var<storage, read> FB: array<f32>;
@group(0) @binding(3) var<storage, read_write> VW: array<Vert>;
@group(0) @binding(4) var<storage, read> VR: array<Vert>;
@group(0) @binding(5) var<storage, read_write> CNT: array<atomic<u32>>;
@group(0) @binding(6) var<storage, read_write> ARGS: array<u32>;
@group(0) @binding(7) var<storage, read> RA: array<f32>;
@group(0) @binding(8) var<storage, read> RB: array<f32>;

